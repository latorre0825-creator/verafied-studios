# VeRaFIED Studios — environment configuration

# Postgres (Drizzle)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ─── Stripe (merch checkout) ─────────────────────────────────────────────────────────
# Connect the Stripe account owned by Tiffaneylatorre@gmail.com.
# Create a Secret key at https://dashboard.stripe.com/apikeys and paste it here.
# Until this is set, the Buy buttons gracefully fall back to "reserve for drop".
# STRIPE_SECRET_KEY=sk_live_xxx

# ─── Vera AI (optional live LLM upgrade) ────────────────────────────────────
# Without these, Vera runs on the built-in studio knowledge engine.
# Set all three to route Vera through an OpenAI-compatible provider.
# VERA_API_KEY=sk-xxx
# VERA_API_BASE_URL=https://api.openai.com/v1
# VERA_MODEL=gpt-4o-mini
